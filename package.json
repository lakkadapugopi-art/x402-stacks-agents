{
  "name": "x402-stacks-agents",
  "version": "0.1.2",
  "description": "Zero-dependency Stacks x402 payment tools, Cloudflare Agents scaffolding, CLI, and MCP server",
  "license": "MIT",
  "author": "lakkadapugopi-art",
  "homepage": "https://github.com/lakkadapugopi-art/x402-stacks-agents#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lakkadapugopi-art/x402-stacks-agents.git"
  },
  "bugs": {
    "url": "https://github.com/lakkadapugopi-art/x402-stacks-agents/issues"
  },
  "main": "./index.js",
  "types": "./index.d.ts",
  "bin": {
    "x402-stacks-agents": "./bin/cli.js"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./stacks": {
      "types": "./lib/stacks.d.ts",
      "default": "./lib/stacks.js"
    },
    "./x402": {
      "types": "./lib/x402.d.ts",
      "default": "./lib/x402.js"
    },
    "./project": {
      "types": "./lib/project.d.ts",
      "default": "./lib/project.js"
    },
    "./errors": {
      "types": "./lib/errors.d.ts",
      "default": "./lib/errors.js"
    },
    "./validation": {
      "types": "./lib/validation.d.ts",
      "default": "./lib/validation.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin/",
    "lib/",
    "templates/",
    "index.js",
    "index.d.ts",
    "mcp-server.js",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.5"
  },
  "keywords": [
    "x402",
    "stacks",
    "cloudflare-agents",
    "payments",
    "mcp",
    "model-context-protocol",
    "sbtc",
    "stx"
  ],
  "scripts": {
    "start": "node mcp-server.js",
    "mcp-start": "node mcp-server.js",
    "test": "node test/run-tests.js",
    "test:stacks": "node test/stacks.js",
    "test:x402": "node test/x402.js",
    "test:cli": "node test/cli.js",
    "test:mcp": "node test/mcp-smoke.js",
    "test:packed": "node test/packed-artifact.js",
    "test:all": "npm test && npm run test:packed"
  }
}
